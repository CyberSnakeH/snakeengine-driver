# Build artifacts (kernel + C/C++ — keep narrow so Go's go.mod survives)
*.o
*.ko
*.symvers
*.order
.*.cmd
.*.d
.tmp_versions/

# Kernel-specific *.mod files (don't use bare *.mod — Go's go.mod is
# legitimate source).
kernel/*.mod
kernel/*.mod.c

# Kernel build
kernel/Module.symvers
kernel/modules.order
kernel/snakedrv.ko
kernel/snakedrv.mod
kernel/snakedrv.mod.c
kernel/snakedrv.mod.o
kernel/snakedrv.o
kernel/snakedrv_*.o
kernel/.module-common.o
kernel/module-common.o

# Userland build
userland/build/
userland/libsnakedrv.so
userland/libsnakedrv.a
userland/*.o

# SELinux build artifacts (source files: .te .fc .if are tracked, .pp is compiled)
security/tmp/
security/snakeengine.pp

# Tests (excluded from repo — kept local)
tests/

# Engine (lives in its own repo: CyberSnakeH/SnakeEngine)
Engine/
Engine.qml-backup/

# Editor / OS noise
*.swp
*.swo
.DS_Store
.idea/
.vscode/
